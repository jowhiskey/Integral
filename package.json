{
  "name": "integral",
  "version": "0.1.0",
  "description": "Isomorphic WYSIWYG math editor package: direct AST manipulation, MathML Core rendering, mathjs conversion.",
  "type": "module",
  "exports": {
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "import": "./dist/ast/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.editor.json && cp src/editor/*.svelte dist/editor/",
    "test": "vitest run",
    "dev": "vite demo"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.1"
  }
}
